# Firefly configuration. Copy this file to .env and edit it. Never commit real values.
# Firefly loads .env automatically on startup; variables already set in the environment win.

# --- Server ---------------------------------------------------------------------------
# Port and host the Firefly server listens on. Keep the host on loopback unless you have
# put authentication and TLS in front of it (Firefly has no built-in sign-in).
FIREFLY_PORT=8787
FIREFLY_HOST=127.0.0.1
# Where the local SQLite database is stored.
FIREFLY_DB_PATH=./data/firefly.db
# How much the server prints: info (every request, the default), warn, error or silent.
# Startup messages are always shown. Logs never contain transcripts or secrets.
FIREFLY_LOG_LEVEL=info

# --- AI provider ----------------------------------------------------------------------
# mock              Built-in demo mode. No credentials needed. Customer replies, turn
#                   classification and coaching come from Firefly's rules engine and are
#                   labelled "Demo mode" everywhere in the app.
# azure-openai      Azure OpenAI chat-completions deployment (values below).
# openai-compatible Any OpenAI-compatible chat-completions endpoint (values below).
# gemini            Google's Gemini API, for example a key from Google AI Studio (values below).
FIREFLY_PROVIDER=mock

# azure-openai
AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com>
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=<api-version>

# openai-compatible
FIREFLY_LLM_BASE_URL=<https://your-endpoint/v1>
FIREFLY_LLM_API_KEY=<your-api-key>
FIREFLY_LLM_MODEL=<model-name>

# gemini
# Only the key is required. Unpaid (free-tier) use is rate limited, and Google's terms say it
# may use and human-review what is sent, so use fictional scenarios only (docs/ai-providers.md).
GEMINI_API_KEY=<your-api-key>
# Optional. Defaults to a fast, low-cost model; set it to use another Gemini model.
# GEMINI_MODEL=<model-name>
# Optional. Defaults to Google's OpenAI-compatible endpoint.
# GEMINI_BASE_URL=<https://generativelanguage.googleapis.com/v1beta/openai>

# Optional model call limits (milliseconds / count).
FIREFLY_LLM_TIMEOUT_MS=30000
FIREFLY_LLM_MAX_RETRIES=1

# --- Speech (spoken calls) --------------------------------------------------------------
# Typed calls always work. Spoken calls need a speech provider:
# none          Speech is off. This is the default.
# mock          A scripted demonstration for tests and demos, labelled "Demo speech (scripted)".
#               It does not understand audio: it answers with the next line from a short fixed
#               list, and the customer's "voice" is a soft sound.
# azure-speech  Azure AI Speech. The trainee's recording is sent to the service to be turned into
#               text, and the customer's lines are sent to it to be spoken. Firefly never stores
#               audio. Use fictional scenarios only. Values below.
FIREFLY_SPEECH_PROVIDER=none

# azure-speech: a key, and either a region or an address. The key stays on the server: it is never
# sent to the browser, logged or shown in an error.
AZURE_SPEECH_KEY=<your-speech-key>
# The region of the Speech resource, for example uksouth (public Azure regions).
AZURE_SPEECH_REGION=<your-region>
# Or the address of the resource instead. It wins if both are set. Any https address works, such as
# <https://your-resource.cognitiveservices.azure.com>, a private endpoint or a sovereign cloud.
# AZURE_SPEECH_ENDPOINT=<https://your-resource.cognitiveservices.azure.com>
# Optional. Replace the built-in voice for a speaker, in every language. Use a prebuilt Azure voice
# name such as en-GB-LibbyNeural: Firefly does not use custom, personal or cloned voices. A style
# (for a frustrated or angry customer) is applied to a voice only where Microsoft's documentation
# lists that style for the voice; any other voice is given pace and pitch only.
# AZURE_SPEECH_VOICE_FEMALE=<voice-name>
# AZURE_SPEECH_VOICE_MALE=<voice-name>
# These two apply only to the older pairing by a scenario's speaker hint. The four neutral voices
# the trainee chooses between (Voice A to Voice D) use the built-in catalogue in
# server/speech/voices.ts.
# Optional request limit for each call to the speech service (1000 to 60000 milliseconds).
FIREFLY_SPEECH_TIMEOUT_MS=15000
# Optional live check, never run in CI and never needed to use the app: set to 1 (together with
# the Azure variables above) to let the speech smoke test speak one short sentence and transcribe
# it back. It writes no audio to disk. See docs/voice-architecture.md.
# FIREFLY_LIVE_SPEECH_SMOKE=1

# --- Development and testing only -----------------------------------------------------
# Artificial delay for demo-mode customer replies so the typing state is visible.
FIREFLY_MOCK_DELAY_MS=700
# Enables /api/test/* hooks used by the automated tests, which can make the next model call or the
# next speech call fail. Never enable on a shared host.
FIREFLY_TEST_HOOKS=0
# Exposes /api/dev/* diagnostics (hidden facts, raw state). Never enable on a shared host.
FIREFLY_DEV_DIAGNOSTICS=0
